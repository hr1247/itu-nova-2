# ITU Nova Backend Environment Variables
PORT=5000

# Google Gemini (Free Tier Model: gemini-3.5-flash-lite with Real-Time Grounding)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI Configuration (Optional backup)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Self-Learning Engine: Set to false in production to require admin review before corrections take effect
AUTO_APPROVE_CORRECTIONS=false
