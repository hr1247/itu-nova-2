# ==========================================
# ITU Nova - Environment Configuration
# ==========================================

# Backend Port (Default: 5000)
PORT=5000

# Google Gemini API Key (Primary Free Provider for General Mode & Real-Time Grounding)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API Configuration (Optional backup for General Mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Self-Learning Configuration
AUTO_APPROVE_CORRECTIONS=true
