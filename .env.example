# ==========================================
# ITU Nova - Environment Configuration
# ==========================================

# Backend Port (Default: 5000)
PORT=5000

# Google Gemini API Key (Optional)
# If provided, enables dynamic Gemini generative reasoning.
# If omitted, ITU Nova's built-in intelligent reasoning engine runs out of the box!
GEMINI_API_KEY=

# Groq API Key (Optional)
# Required for General mode queries and Auto fallback when ITU is not matched.
GROQ_API_KEY=
